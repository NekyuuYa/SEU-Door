<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/reset_title"
            android:textColor="@color/color_on_surface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/reset_hint"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fld_phn"
            android:textColor="@color/color_on_surface"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/reset_phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:inputType="phone"
            android:digits="0123456789"
            android:maxLength="11"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_sms_code"
            android:textColor="@color/color_on_surface"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/reset_code_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text"
                android:inputType="number"
                android:maxLength="8"
                android:singleLine="true"
                android:padding="14dp"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp" />

            <Button
                android:id="@+id/reset_send_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/reset_send_code"
                android:textAllCaps="false"
                android:textColor="@color/color_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_new_password"
            android:textColor="@color/color_on_surface"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/reset_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_confirm_password"
            android:textColor="@color/color_on_surface"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/reset_confirmation_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reset_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/color_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reset_cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@android:string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/color_primary" />

            <Button
                android:id="@+id/reset_submit_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="@string/reset_submit"
                android:textAllCaps="false"
                android:textColor="@color/button_primary_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
