CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=1
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# WiFi + BLE coexistence on C3 (SW coex), bigger ATT MTU for config payloads,
# SNTP for API request timestamps
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# App with WiFi+TLS exceeds 1MB -> 4MB flash + custom partition table
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
